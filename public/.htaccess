# Static Nuxt build served by LiteSpeed or Apache (Hostinger).
ErrorDocument 404 /404.html
DirectoryIndex index.html
# Pages live in folders (/about/index.html): serve /about directly instead of redirecting to /about/.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Always HTTPS, without www.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://essejacques.me%{REQUEST_URI} [L,R=301]
  # /portfolio/ and /portfolio serve the same page: keep the URL without a trailing slash.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [L,R=301]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed build files and media never change under the same name.
  <FilesMatch "\.(js|css|woff2|webp|jpg|png|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
